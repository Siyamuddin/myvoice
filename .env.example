# =============================================================================
# myvoice — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit the real .env (it is gitignored).
# =============================================================================

# --- Application ---
SPRING_PROFILES_ACTIVE=prod
APP_JWT_SECRET=change-me-32-chars-minimum-please-1234

# --- Voice Agent (Gemini Live) ---
# Required for the /voice feature. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
VOICE_SYSTEM_PROMPT=You are a helpful AI assistant. You speak English, Bangla, and Korean naturally and switch to match the user's language. Be concise and conversational.
VOICE_MAX_SESSIONS_PER_USER=1

# --- Email ---
# No real SMTP by default: set APP_REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false
# so accounts can log in without a verification email.
APP_REQUIRE_EMAIL_VERIFICATION_FOR_LOGIN=false
APP_EMAIL_FROM=noreply@saasstarter.com
APP_EMAIL_FROM_NAME=myvoice
APP_EMAIL_VERIFICATION_BASE_URL=http://localhost:5174/api/v1/auth/verify-email
APP_EMAIL_PASSWORD_RESET_BASE_URL=http://localhost:5174/api/v1/auth/reset-password
APP_EMAIL_ENABLED=true

# --- SMTP (override for real delivery) ---
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_TLS=false

# --- Database ---
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_PORT_MAPPING=3307
MYSQL_DATABASE=saas-app
MYSQL_ROOT_PASSWORD=rootpassword
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=rootpassword

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6381
APP_CACHING_ENABLED=true

# --- CORS ---
# Comma-separated. Include the Tailscale serve origin if you expose the app
# over HTTPS (e.g. https://uddins-macbook-air-2.tail023d45.ts.net).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5174

# --- Frontend (baked at build time; same-origin is used in production) ---
VITE_API_BASE_URL=http://localhost:9090
